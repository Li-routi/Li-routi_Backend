# 이 파일을 기준으로 값을 채워 GitHub Secret ENV_FILE 에 등록한다.
# 배포 워크플로가 그 내용을 서버 /opt/app/.env 로 기록하고, docker-compose.prod.yml 이 ${...} 로 주입한다.
# 이 example만 레포에 커밋하고, 실제 값은 절대 커밋하지 않는다.

# --- DB (compose의 mysql 컨테이너가 이 값으로 초기화됨) ---
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# --- 애플리케이션 필수 비밀값 (없으면 부팅 실패: fail-fast) ---
JWT_SECRET=change-me-32bytes-이상-랜덤-문자열
KAKAO_APP_ID=1234567890
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_ALLOWED_ISSUERS=https://accounts.google.com

# --- AWS S3 (미디어 업로드 presigned URL) ---
# 자격증명은 여기 두지 않는다 — EC2 instance profile(IAM Role)로 SDK가 자동 획득.
AWS_S3_BUCKET=lirouti-prod-bucket
AWS_REGION=ap-northeast-2
# (선택) 저장된 미디어를 읽을 공개 주소. 미설정이면 compose가 위 버킷·리전으로
# https://s3.<리전>.amazonaws.com/<버킷> (path-style)을 계산해 쓴다(버킷이 공개면 그대로 동작).
# CloudFront 등을 붙이면 그 도메인으로 이 값을 채워 오리진을 덮어쓴다.
# AWS_S3_PUBLIC_BASE_URL=https://xxxxxxxx.cloudfront.net

# --- 요청 빈도 제한 (#23, 평소에는 건드리지 않는다) ---
# presigned URL 발급을 사용자당 시간당 20건으로 제한한다(발급 1건 = 최대 10MB 업로드 허용).
# 값은 application.yaml의 기본값이면 충분하다. 아래는 조정이 필요할 때만 쓴다.
# RATE_LIMIT_MEDIA_PRESIGN_LIMIT=20
# RATE_LIMIT_MEDIA_PRESIGN_WINDOW=PT1H
#
# 오탐으로 정상 사용자가 막히면 전체를 끈다(재배포 필요).
# Redis 장애 시에는 끌 필요가 없다 — 검사 실패는 자동으로 통과 처리된다(fail-open).
# RATE_LIMIT_ENABLED=false

# --- FCM 푸시 알림 (선택, 미설정이면 기본 꺼짐) ---
# 서비스 계정 키(JSON)는 여기(ENV_FILE)에 넣지 않는다 — 평문 key=value 형식이라 JSON 파일을
# 담기 부적합하다. Caddyfile처럼 서버에 별도 scp하는 파일로 두고(README 8번 섹션),
# docker-compose.prod.yml이 그 파일을 컨테이너에 읽기 전용으로 마운트한다.
# FCM_ENABLED=true
# FCM_PROJECT_ID=your-firebase-project-id
# (선택) 서버의 키 파일 경로가 /opt/app/secrets/firebase-adminsdk.json이 아니면 지정
# FCM_CREDENTIALS_HOST_PATH=/opt/app/secrets/firebase-adminsdk.json

# --- 재화 충전 결제 (포트원 V2) ---
# 관리자 콘솔(admin.portone.io)의 [결제 연동] → [연동 관리] 에서 얻는다.
#   API Secret : [식별코드·API Keys] → [V2 API] → 새로운 API Secret 발급
#                발급 직후에만 보인다. 놓치면 새로 발급하고 옛 것을 폐기해야 한다.
#   상점 아이디 : [연동 관리] 화면에서 복사
#
# PG사(토스페이먼츠)의 시크릿·클라이언트 키는 여기 넣지 않는다 — 포트원 콘솔에만 있고
# 서버는 포트원에만 말한다. 그래서 PG를 바꿔도 이 값들은 그대로다.
#
# 둘 다 없으면 부팅이 막힌다. 의도된 게이트다 — 검증 없이 지급되면 재화가 공짜가 되므로
# AI 심사처럼 fail-open 으로 두지 않았다.
PORTONE_API_SECRET=
PORTONE_STORE_ID=
# 충전 기능을 통째로 내릴 때만 false. "검증을 건너뛴다"가 아니라 "충전을 막는다"는 뜻이다.
# PORTONE_ENABLED=false

# --- DB 스키마 (평소에는 건드리지 않는다) ---
# 스키마는 Flyway가 관리하고 Hibernate는 대조(validate)만 한다. 그게 compose의 기본값이다.
# 마이그레이션 문제로 부팅이 막혀 배포가 통째로 멈출 때만, 아래를 켜서 한시적으로 우회한다.
# 우회한 뒤에는 반드시 마이그레이션으로 정리하고 이 줄을 다시 지운다.
# JPA_DDL_AUTO=update

# --- 배포 이미지 태그 ---
# 이 줄은 GitHub Secret(ENV_FILE)에 넣지 않는다. 배포 워크플로가 그 배포의 커밋 sha로 덧붙인다.
# 서버에서 임시 롤백할 때만 직접 수정한다(다음 배포에서 원복됨).
# APP_IMAGE_TAG=<커밋sha>   (배포가 자동으로 추가)
